{
    "redirects": [
        {
            "source": "/chat(.html)?",
            "destination": "/ecosystem.html",
            "permanent": false
        },
        {
            "source": "/graphofone(.html)?",
            "destination": "/ecosystem.html",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/install.sh",
            "destination": "https://raw.githubusercontent.com/scobru/tunecamp/main/install.sh"
        }
    ],
    "functions": {
        "api/network.js": {
            "includeFiles": "config.js",
            "maxDuration": 30
        }
    }
}
